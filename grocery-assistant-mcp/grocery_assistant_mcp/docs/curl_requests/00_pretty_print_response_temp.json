{
  "jsonrpc": "2.0",
  "id": 4,
  "result": {
    "tools": [
      {
        "name": "search_inventory",
        "description": "\nSearch the current grocery inventory.\n\nUse this tool when the user asks whether a specific food item is available,\nwants to find items in a category, or wants to check items stored in a\nparticular location.\n\nThis is a read-only tool. It does not add, update, remove, or consume\ninventory items.\n\nReturns matching inventory rows from user_inventory.csv.\n",
        "inputSchema": {
          "properties": {
            "query": {
              "default": "",
              "description": "Optional text search across inventory item name, brand, and notes. Use this for searches like \"chicken\", \"oats\", \"pasta\", or \"use soon\". Leave blank when filtering only by category or location.",
              "title": "Query",
              "type": "string"
            },
            "category": {
              "default": "",
              "description": "Optional inventory category filter. Use broad categories such as \"pantry\", \"protein\", \"dairy\", \"vegetable\", \"fruit\", or \"snack\". Leave blank if category is not needed.",
              "title": "Category",
              "type": "string"
            },
            "location": {
              "default": "",
              "description": "Optional storage location filter. Use locations such as \"cupboard\", \"fridge\", \"freezer\", or \"pantry\". Leave blank if location is not needed.",
              "title": "Location",
              "type": "string"
            }
          },
          "title": "search_inventoryArguments",
          "type": "object"
        },
        "outputSchema": {
          "properties": {
            "result": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "title": "Result",
              "type": "array"
            }
          },
          "required": [
            "result"
          ],
          "title": "search_inventoryOutput",
          "type": "object"
        }
      },
      {
        "name": "add_inventory_item",
        "description": "\nAdd one new grocery inventory item.\n\nUse this when the user wants to record a new grocery item that is not\nalready represented in the inventory.\n\nThis tool creates a new inventory row and the service layer generates\nthe stock_id internally.\n\nDo not use this tool to update an existing item, reduce servings, mark\nan item as consumed, or correct an existing inventory row.\n",
        "inputSchema": {
          "properties": {
            "food_item": {
              "description": "Name of the food item to add. Required. Example: \"Rolled oats\".",
              "title": "Food Item",
              "type": "string"
            },
            "brand": {
              "default": "",
              "description": "Brand name if known. Leave blank if unknown. Example: \"Uncle Tobys\".",
              "title": "Brand",
              "type": "string"
            },
            "category": {
              "default": "",
              "description": "Broad food category. Example: \"pantry\", \"protein\", \"dairy\", \"vegetable\", \"fruit\".",
              "title": "Category",
              "type": "string"
            },
            "location": {
              "default": "",
              "description": "Storage location. Example: \"cupboard\", \"fridge\", \"freezer\", \"pantry\".",
              "title": "Location",
              "type": "string"
            },
            "quantity": {
              "default": 0,
              "description": "Numeric amount of the item. Use with unit. Example: 1 for one bag, 500 for 500 g.",
              "title": "Quantity",
              "type": "number"
            },
            "unit": {
              "default": "",
              "description": "Unit for quantity. Example: \"bag\", \"packet\", \"g\", \"kg\", \"can\", \"item\".",
              "title": "Unit",
              "type": "string"
            },
            "servings_remaining": {
              "default": 0,
              "description": "Estimated number of usable servings remaining. Example: 10.",
              "title": "Servings Remaining",
              "type": "number"
            },
            "stock_status": {
              "default": "ok",
              "description": "Current inventory status. Use \"ok\", \"low\", \"empty\", \"used\", \"expired\", or \"removed\".",
              "title": "Stock Status",
              "type": "string"
            },
            "expiry_date": {
              "default": "",
              "description": "Expiry or use-by date in YYYY-MM-DD format. Leave blank if unknown.",
              "title": "Expiry Date",
              "type": "string"
            },
            "notes": {
              "default": "",
              "description": "Optional notes about the item. Example: \"Use soon\" or \"Added during grocery shop\".",
              "title": "Notes",
              "type": "string"
            }
          },
          "required": [
            "food_item"
          ],
          "title": "add_inventory_itemArguments",
          "type": "object"
        }
      },
      {
        "name": "update_inventory_item",
        "description": "\nUpdate an existing inventory item by stock_id.\n\nOnly fields provided by the caller are updated.\nFields left as None are not changed.\n\nUse this tool when the user wants to:\n- correct an inventory item\n- change quantity or servings remaining\n- update stock status\n- update expiry date\n- move an item to a different location\n- add or clear notes\n",
        "inputSchema": {
          "properties": {
            "stock_id": {
              "title": "Stock Id",
              "type": "string"
            },
            "food_item": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Food Item"
            },
            "brand": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Brand"
            },
            "category": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Category"
            },
            "location": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Location"
            },
            "quantity": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Quantity"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Unit"
            },
            "servings_remaining": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Servings Remaining"
            },
            "stock_status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Stock Status"
            },
            "expiry_date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expiry Date"
            },
            "notes": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Notes"
            }
          },
          "required": [
            "stock_id"
          ],
          "title": "update_inventory_itemArguments",
          "type": "object"
        }
      },
      {
        "name": "remove_inventory_item",
        "description": "\nRemove an item from active inventory.\n\nUse this when the user says an item should leave active inventory,\nincluding when it was used up, expired, spoiled, discarded, duplicated,\nincorrectly added, or no longer available.\n\nThis tool records a food waste entry only when removal_type is one of:\n- expired\n- spoiled\n- discarded\n- unused\n- overbought\n- did_not_like\n\nThis tool does not record food waste when removal_type is one of:\n- used_up\n- duplicate_entry\n- incorrect_entry\n- test_entry\n- unknown\n\nIf quantity_wasted or servings_wasted are not supplied for a waste-type\nremoval, the service uses the item's current remaining quantity and\nservings as the estimated wasted amount.\n",
        "inputSchema": {
          "properties": {
            "stock_id": {
              "title": "Stock Id",
              "type": "string"
            },
            "removal_type": {
              "default": "unknown",
              "title": "Removal Type",
              "type": "string"
            },
            "removal_reason": {
              "default": "",
              "title": "Removal Reason",
              "type": "string"
            },
            "quantity_wasted": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Quantity Wasted"
            },
            "servings_wasted": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Servings Wasted"
            },
            "tracking_confidence": {
              "default": "medium",
              "title": "Tracking Confidence",
              "type": "string"
            },
            "notes": {
              "default": "",
              "title": "Notes",
              "type": "string"
            }
          },
          "required": [
            "stock_id"
          ],
          "title": "remove_inventory_itemArguments",
          "type": "object"
        }
      },
      {
